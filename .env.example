# Power Hunt configuration. Copy to .env for local development; never commit .env.
# In production, set these on the hosting platform's variables tab.
# Keep comments on their own lines: Docker, CI and hosting dashboards treat anything after "="
# as the value, including a trailing "# comment".
# After pulling changes, run `python scripts/sync_env.py` to add new keys while keeping your values.

# ----- Core -----
# development | test | production. Production enables HSTS, hides /docs and enforces a strong SECRET_KEY.
APP_ENV=development
# Public address of the app; used for sign-in callbacks and links in emails.
APP_BASE_URL=http://localhost:8000
# 32+ random characters: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# true for JSON logs (production); false for readable logs in a terminal.
LOG_JSON=false
# Port the server listens on inside the container; must match the platform's published port.
PORT=8000

# ----- Database -----
# Neon Postgres (postgresql://...?sslmode=require) or SQLite for offline work (sqlite:///./power_hunt.db).
DATABASE_URL=sqlite:///./power_hunt.db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# ----- Proxy and scaling -----
# Proxies allowed to set X-Forwarded-For. List only your platform's proxy addresses; "*" lets any
# client fake its IP and bypass rate limits.
FORWARDED_ALLOW_IPS=127.0.0.1
# Worker processes. With more than 1, use a shared rate limit store (redis://...).
WEB_CONCURRENCY=1
RATE_LIMIT_STORAGE_URI=memory://

# ----- Rate limits (N/second|minute|hour|day; several separated by ";") -----
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_SIGNUP=5/minute
RATE_LIMIT_OAUTH=20/minute
RATE_LIMIT_INGEST=10/minute
RATE_LIMIT_LOOKUP=120/minute

# ----- Request limits -----
MAX_UPLOAD_MB=5
MAX_JSON_KB=64

# ----- Sign-in -----
SESSION_DAYS=7
# Google sign-in is optional; the button shows when both are set.
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
# Authorised redirect URI: {APP_BASE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ----- Demo account (created at startup when both are set) -----
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
DEMO_GITHUB_USERNAME=

# ----- LLM -----
GROQ_API_KEY=
# Use models marked Production in the Groq console.
LLM_PRIMARY_MODEL=llama-3.3-70b-versatile
LLM_FALLBACK_MODEL=llama-3.1-8b-instant
# Optional second provider, used when Groq is unavailable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=2048

# ----- Outbound HTTP -----
HTTP_TIMEOUT_SECONDS=10
FETCH_MAX_BYTES=2097152
FETCH_MAX_REDIRECTS=5
# Renders JavaScript-built pages (portfolios). Empty disables the fallback.
JINA_READER_URL=https://r.jina.ai/
GITHUB_API_URL=https://api.github.com
# Optional; raises GitHub's limit from 60 to 5,000 requests an hour. Fine-grained, public repos, read-only.
GITHUB_TOKEN=
GITHUB_MAX_REPOS=30
GITHUB_LANGUAGE_DETAIL_REPOS=10

# ----- Input interpretation -----
# Country (ISO 3166 alpha-2) for phone numbers typed without a country code.
DEFAULT_PHONE_REGION=PK

# ----- Jobs and research -----
# JSearch on RapidAPI.
RAPIDAPI_KEY=
TAVILY_API_KEY=
# true: jobs and research come from recorded fixtures, so a live demo never depends on quotas.
DEMO_MODE=false
SCOUT_INTERVAL_HOURS=6
INFER_THRESHOLD=0.78

# ----- Email (Gmail SMTP with an App Password) -----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
