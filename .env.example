# Copy to .env for local development. Never commit .env.
# In production, set these on the Alternate Clouds Variables tab.

# --- Core ---
APP_ENV=development                 # production enables HSTS, hides /docs, and requires SECRET_KEY
APP_BASE_URL=http://localhost:8000  # used to build signed Apply links in digest emails
SECRET_KEY=                         # 48+ random chars: python -c "import secrets; print(secrets.token_urlsafe(48))"
LOG_LEVEL=INFO
LOG_JSON=false                      # true in production
PORT=3000                           # container port; must match the port Alternate Clouds publishes (3000 by default)

# --- Database ---
# Local: SQLite. Production: Neon Postgres URL (postgresql://...?sslmode=require).
DATABASE_URL=sqlite+aiosqlite:///./power_hunt.db

# --- LLM (Phase 3) ---
GROQ_API_KEY=
LLM_PRIMARY_MODEL=llama-3.3-70b-versatile
LLM_FALLBACK_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=                     # optional second provider

# --- Jobs and research (Phases 2 and 5) ---
RAPIDAPI_KEY=                       # JSearch
TAVILY_API_KEY=
GITHUB_TOKEN=                       # optional, raises GitHub API rate limits

# --- Email (Phases 2 and 4) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=                  # Gmail App Password, not the account password

# --- Behaviour ---
DEMO_MODE=false                     # true: jobs and research come from recorded fixtures
INFER_THRESHOLD=0.78
SCOUT_INTERVAL_HOURS=6
